{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "feature/dashboard-first-lifecycle": false,
      "feature/account-administration-lifecycle-v4": false,
      "feature/churn-prevention-winback": false,
      "feature/dashboard-notification-center": false,
      "feature/leo-operational-intelligence": false,
      "feature/leo-conversational-lifecycle": false,
      "feature/proactive-lifecycle-monitoring": false,
      "hotfix/vercel-lifecycle-cron-daily": false,
      "feature/realestate-email-home-cta": false,
      "feature/a2-a3-tenant-membership-permissions": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/maia-safety-net",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/leo-lifecycle-monitor",
      "schedule": "17 6 * * *"
    },
    {
      "path": "/api/cron/limitless-installment-reminders",
      "schedule": "0 9 * * *"
    }
  ]
}

    {"parameters":{"jsCode":"const env=$('Attach Eligibility Result').first().json; const snap=$json.snapshot; if(!snap) throw new Error('Runtime snapshot not found'); const policy=env.policy||{}; const f=env.input?.follow_up_context||{}; const step=Number(f.sequence_step||1); const seq=Array.isArray(policy.sequence)?policy.sequence:[]; const stepConfig=seq.find(s=>Number(s.step)===step)||seq[Math.max(0,step-1)]||{}; const schema={action:'send|handoff|close|skip',channel:'whatsapp|email|web_chat|telegram|voice|internal',priority:'low|normal|high|urgent',reason:'string',message:'string|null',subject:'string|null',lead_stage:'contacted|qualified|nurturing|appointment|won|lost|inactive',task_status:'completed|cancelled|blocked',handoff_required:'boolean',handoff_reason:'string|null',stop_sequence:'boolean',memory_facts:[{type:'preference|fact|goal|objection|follow_up',summary:'string',confidence:'0-1'}]}; const rules=['You are executing a tenant CRM follow-up sequence.','Use the organization policy, customer history, memory, knowledge and the exact specific interest.','Never invent property/product facts, scarcity, price, promotion, deadline or availability.','Campaign-only recipients who never engaged must not be followed up.','The sequence timing is fixed by policy. Do not invent a next date.','If the customer replied, booked, converted, opted out, entered human handoff, or the interest is unavailable, stop or skip.','Never claim a message was sent. Return strict JSON only.'].join('\\n'); return [{json:{...env,execution_id:$('Queue Follow-Up Execution').first().json.execution_id,snapshot:snap,sequence_step:step,sequence_step_config:stepConfig,provider_request:{execution_id:$('Queue Follow-Up Execution').first().json.execution_id,organization_id:env.organization_id,agent_id:env.agent_id,purpose:'crm_follow_up',instructions:(snap.compiled_prompt||'')+'\\n\\n'+rules+'\\nSchema: '+JSON.stringify(schema),input:JSON.stringify({event_type:env.event_type,channel:env.channel,policy,sequence_step:step,sequence_step_config:stepConfig,specific_interest:env.eligibility?.specific_interest||f.specific_interest||f.property_interest||null,customer:env.input.customer||{},lead:env.input.lead||{},task:env.input.task||{},conversation:env.input.conversation||{},follow_up_context:f,knowledge:snap.knowledge||snap.knowledge_context||null,memory:snap.memory||snap.memory_context||null})}}}];"},"id":"build-request","name":"Build Contextual Follow-Up Request","type":"n8n-nodes-base.code","typeVersion":2,"position":[480,-220]},
    {"parameters":{"method":"POST","url":"={{$env.FLUXKNIGHT_APP_URL + '/api/internal/runtime/provider/execute'}}","sendHeaders":true,"headerParameters":{"parameters":[{"name":"x-runtime-secret","value":"={{$env.RUNTIME_GATEWAY_SECRET}}"},{"name":"content-type","value":"application/json"}]},"sendBody":true,"contentType":"raw","rawContentType":"application/json","body":"={{JSON.stringify($json.provider_request)}}","options":{"timeout":90000}},"id":"provider","name":"Run Assigned Follow-Up AI","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[700,-220],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},
    {"parameters":{"jsCode":"const ctx=$('Build Contextual Follow-Up Request').first().json; let raw=$json.output_text||$json.text||$json.response_text; if(!raw&&Array.isArray($json.output)) raw=$json.output.flatMap(x=>x.content||[]).map(x=>x.text||x.output_text||'').join(''); raw=String(raw||'').replace(/^```json\\s*/i,'').replace(/```$/,'').trim(); let d; try{d=JSON.parse(raw)}catch{throw new Error('Invalid follow-up AI JSON: '+raw.slice(0,300))} const actions=['send','handoff','close','skip']; const channels=['whatsapp','email','web_chat','telegram','voice','internal']; d.action=actions.includes(d.action)?d.action:'skip'; d.channel=channels.includes(d.channel)?d.channel:ctx.channel; d.handoff_required=Boolean(d.handoff_required||d.action==='handoff'); d.stop_sequence=Boolean(d.stop_sequence||d.action==='close'); d.memory_facts=Array.isArray(d.memory_facts)?d.memory_facts:[]; d.next_follow_up_at=null; if(d.action==='send'&&!String(d.message||'').trim()) throw new Error('Follow-up send action requires message'); return [{json:{...ctx,decision:d,provider_usage:$json.usage||{},provider_response_id:$json.id||$json.response_id||null}}];"},"id":"parse","name":"Parse Safe Follow-Up Decision","type":"n8n-nodes-base.code","typeVersion":2,"position":[920,-220]},

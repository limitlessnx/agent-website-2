    {"parameters":{"jsCode":"const b=$json.body??$json; const required=['organization_id','agent_id','idempotency_key','event_type']; const missing=required.filter(k=>b[k]===undefined||b[k]===null||b[k]===''); if(missing.length) throw new Error('Missing required tenant fields: '+missing.join(', ')); const allowed=['follow_up.due','follow_up.manual','task.retry','customer.replied','appointment.booked','purchase.started','lead.won','lead.lost','customer.opted_out','human.handoff','interest.unavailable']; if(!allowed.includes(String(b.event_type))) throw new Error('Unsupported follow-up event'); const input=b.input||{}; const customerKey=String(b.customer_id||input.customer_key||input.email||input.phone||input.customer?.email||input.customer?.phone||'').trim(); if(!customerKey&&!['lead.won','lead.lost'].includes(String(b.event_type))) throw new Error('customer_id or customer identifier required'); const channel=String(b.channel||input.preferred_channel||'internal'); const channels=['whatsapp','email','web_chat','telegram','voice','internal']; if(!channels.includes(channel)) throw new Error('Unsupported channel'); return [{json:{organization_id:String(b.organization_id),organization_key:b.organization_key||input.organization_key||null,agent_id:String(b.agent_id),conversation_id:b.conversation_id||null,customer_id:b.customer_id||null,customer_key:customerKey||String(b.customer_id||''),lead_id:b.lead_id||input.lead_id||null,task_id:b.task_id||input.task_id||null,idempotency_key:String(b.idempotency_key),channel,event_type:String(b.event_type),input,is_webhook:true,source:'webhook',workflow_key:'crm_follow_up_v3',received_at:new Date().toISOString()}}];"},"id":"normalize-webhook","name":"Normalize Webhook Envelope","type":"n8n-nodes-base.code","typeVersion":2,"position":[-1980,180]},

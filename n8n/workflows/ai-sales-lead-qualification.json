    {
      "parameters": {
        "jsCode": "const ctx=$('Build Qualification Request').first().json; let raw=$json.output_text; if(!raw&&Array.isArray($json.output)) raw=$json.output.flatMap(x=>x.content||[]).map(x=>x.text||x.output_text||'').join(''); raw=String(raw||'').replace(/^```json\\s*/i,'').replace(/```$/,'').trim(); let q; try{q=JSON.parse(raw)}catch(e){throw new Error('Invalid AI JSON: '+raw.slice(0,300))} const statuses=['hot','warm','cold','disqualified']; const stages=['new','qualified','contacted','nurturing','appointment','disqualified']; q.qualification_status=statuses.includes(q.qualification_status)?q.qualification_status:'warm'; q.score=Math.max(0,Math.min(100,Math.round(Number(q.score)||0))); q.stage=stages.includes(q.stage)?q.stage:(q.score>=70?'qualified':q.score>=35?'nurturing':'new'); q.appointment_requested=Boolean(q.appointment_requested); q.handoff_required=Boolean(q.handoff_required); q.objections=Array.isArray(q.objections)?q.objections:[]; q.missing_fields=Array.isArray(q.missing_fields)?q.missing_fields:[]; q.memory_facts=Array.isArray(q.memory_facts)?q.memory_facts:[]; return [{json:{...ctx,qualification:q,provider_usage:$json.usage||{},provider_response_id:$json.id||null}}];"
      },

    {
      "parameters": {
        "jsCode": "const env=$('Validate Tenant Envelope').first().json; const rows=Array.isArray($json)?$json:[$json]; const snap=rows[0]; if(!snap) throw new Error('Runtime snapshot not found'); const schema={qualification_status:'hot|warm|cold|disqualified',score:'0-100 integer',stage:'new|qualified|contacted|nurturing|appointment|disqualified',intent:'string',need:'string',budget:'string|null',timeline:'string|null',location:'string|null',objections:['string'],missing_fields:['name|email|phone|company|budget|timeline|need'],appointment_requested:'boolean',requested_datetime:'ISO datetime|null',handoff_required:'boolean',handoff_reason:'string|null',summary:'string',reply:'string',memory_facts:[{type:'preference|fact|goal|objection',summary:'string',confidence:'0-1'}]}; return [{json:{...env,execution_id:$('Queue Runtime Execution').first().json.execution_id,snapshot:snap,model_request:{model:$env.FLUXKNIGHT_DEFAULT_AI_MODEL||'gpt-5-mini',instructions:snap.compiled_prompt+'\nReturn strict JSON only. Qualification output schema: '+JSON.stringify(schema),input:JSON.stringify({message:env.input.message||env.input.text||'',customer:env.input.customer||{},lead_context:env.input.lead_context||env.input,channel:env.channel})}}}];"
      },

        "jsCode": "const b=$json.body??$json; const required=['organization_id','agent_id','idempotency_key','channel','event_type','input']; const missing=required.filter(k=>b[k]===undefined||b[k]===null||b[k]===''); if(missing.length) throw new Error('Missing required tenant fields: '+missing.join(', ')); const allowed=['whatsapp','email','web_chat','telegram','voice','internal']; if(!allowed.includes(b.channel)) throw new Error('Unsupported channel'); const input=b.input||{}; const customerKey=String(b.customer_id||input.customer_key||input.email||input.phone||'').trim(); if(!customerKey) throw new Error('customer_id or customer identifier required'); return [{json:{organization_id:String(b.organization_id),agent_id:String(b.agent_id),conversation_id:b.conversation_id||null,customer_id:b.customer_id||null,customer_key:customerKey,idempotency_key:String(b.idempotency_key),channel:b.channel,event_type:b.event_type,external_thread_key:b.external_thread_key||input.external_thread_key||null,input,received_at:new Date().toISOString(),workflow_key:'ai_sales_qualification_v2'}}];"

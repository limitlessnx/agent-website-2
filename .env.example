# Fluxknight
# Copy this file to .env.local for local development. Never commit real secrets.

NEXT_PUBLIC_SITE_URL=https://fluxknight.ai
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Supabase browser and SSR authentication
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only platform access. Never prefix secret values with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Agent Leo AI. OPENAI_API_KEY is server-only and must never use NEXT_PUBLIC_.
# After adding or rotating these variables in Vercel, redeploy the affected environment.
OPENAI_API_KEY=
SUPPORT_AI_MODEL=gpt-4o-mini
LEO_AI_MODEL=gpt-5
LEO_REALTIME_MODEL=gpt-realtime
LEO_REALTIME_VOICE=marin

# Agent Leo permanent n8n execution bridge.
# Configure the same strong LEO_N8N_SHARED_SECRET value in Vercel and the n8n environment.
# Use a different long random value for LEO_EXECUTION_SIGNING_SECRET. n8n forwards the
# signed envelope but cannot mint a privileged Leo identity without this server-only secret.
LEO_N8N_SHARED_SECRET=
LEO_EXECUTION_SIGNING_SECRET=
LEO_N8N_EXECUTOR_WEBHOOK_URL=https://n8n.example.com/webhook/fluxknight-leo-executor-v2
LEO_N8N_WEBHOOK_BASE_URL=https://n8n.example.com/webhook
LEO_CRM_FOLLOWUP_WEBHOOK_URL=https://n8n.example.com/webhook/fluxknight/crm-follow-up/v3
LEO_APPOINTMENT_WEBHOOK_URL=https://n8n.example.com/webhook/fluxknight/appointments/v4
LEO_CAMPAIGN_EXECUTOR_WEBHOOK_URL=
FLUXKNIGHT_APP_URL=https://fluxknight.ai

# Existing protected runtime bridge used by Fluxknight business workflows.
RUNTIME_GATEWAY_SECRET=

# Automation providers
N8N_WEBHOOK_URL=
N8N_BASE_URL=
N8N_API_KEY=
N8N_EMAIL=
N8N_PASSWORD=
RESEND_API_KEY=
LIMITLESS_API_KEY=

# Google Drive property media uploads
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_PROPERTY_FOLDER_ID=
